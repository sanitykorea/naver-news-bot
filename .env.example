# cp .env.example .env  후 값만 채우면 됨. .env 는 커밋되지 않음.
NAVER_ID=
NAVER_SECRET=
TG_TOKEN=
TG_CHAT=@내채널아이디
# 없어도 동작한다 — 없으면 질적 필터(증권시황·기업홍보·행정이벤트 판별) 없이 기존 규칙만 적용.
# aistudio.google.com/apikey 에서 무료 발급.
GEMINI_API_KEY=
# KEYWORDS 는 이제 keywords.txt 에서 관리한다. 이 줄은 로컬에서만 임시로
# 다른 목록을 테스트하고 싶을 때 주석을 풀어 쓰면 된다(있으면 keywords.txt보다 우선).
# KEYWORDS=성소수자,퀴어,트랜스젠더
